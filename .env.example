# Copy to .env.local and fill in. Never commit real values.

# Supabase → Project Settings → API Keys.
# Use the browser key (sb_publishable_... or the legacy anon key). RLS protects the data.
# Never put the secret key of the database here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only, never NEXT_PUBLIC_. Leave EMPTY to run without AI: the app works fully
# without it (the AI parser itself is planned, not built yet).
ANTHROPIC_API_KEY=

# The bakery's fixed PayBox link. Leave empty to omit the payment link line.
NEXT_PUBLIC_PAYBOX_LINK=
